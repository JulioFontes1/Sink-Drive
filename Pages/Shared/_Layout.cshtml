@using SinkDrive.Models
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SinkDrive</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/SinkDrive.styles.css"
          asp-append-version="true" />
</head>
<body class="app-body">

    <div class="app-shell">

        <aside class="app-sidebar">
            <a class="app-brand" asp-page="/Index">
                <span class="app-brand-icon">
                    <i class="bi bi-cloud"></i>
                </span>
                <span>SinkDrive</span>
            </a>

            <nav class="app-nav" aria-label="Navegação principal">
                <span class="app-nav-label">MENU</span>

                <a class="app-nav-link active" asp-page="/Index">
                    <i class="bi bi-grid"></i>
                    <span>Visão geral</span>
                </a>

                <a class="app-nav-link" asp-page="/Index">
                    <i class="bi bi-folder2-open"></i>
                    <span>Meus arquivos</span>
                </a>

                <a class="app-nav-link" asp-page="/Index">
                    <i class="bi bi-cloud"></i>
                    <span>Contas Google</span>
                </a>
            </nav>

            <div class="app-sidebar-footer">
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="app-nav-link app-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sair da conta</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-header">
                <div class="app-header-title">
                    <span class="app-header-caption">SEU ESPAÇO</span>
                    <span class="app-header-name">Gerenciador de arquivos</span>
                </div>

                <div class="app-user">
                    <div class="app-user-avatar">
                        <i class="bi bi-person"></i>
                    </div>

                    @{
                        var currentUser = await UserManager.GetUserAsync(User);

                        var displayName = !string.IsNullOrWhiteSpace(currentUser?.DisplayName)
                            ? currentUser.DisplayName
                            : currentUser?.UserName ?? "Usuário";
                    }

                    <div class="app-user-info">
                        <span class="app-user-name">@displayName</span>
                        <span class="app-user-status">Conectado</span>
                    </div>
                </div>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                SinkDrive &copy; 2026
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
