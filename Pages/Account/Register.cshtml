
@page
@model SinkDrive.Pages.Account.RegisterModel

@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Criar conta";
}

<section class="auth-card">
    <h1 class="auth-title">Crie sua conta.</h1>

    <p class="auth-description">
        Organize suas contas Google e acesse seus arquivos em um só lugar.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="auth-validation mb-3"
             role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.UserName" class="auth-label"></label>

            <input asp-for="Input.UserName"
                   class="form-control auth-input"
                   placeholder="Escolha um nome de usuário"
                   autocomplete="username"
                   autofocus />

            <span asp-validation-for="Input.UserName"
                  class="auth-validation"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.DisplayName" class="auth-label"></label>

            <input asp-for="Input.DisplayName"
                   class="form-control auth-input"
                   placeholder="Como deseja ser chamado?"
                   autocomplete="nickname" />

            <span asp-validation-for="Input.DisplayName"
                  class="auth-validation"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="auth-label"></label>

            <input asp-for="Input.Password"
                   class="form-control auth-input"
                   placeholder="Crie uma senha"
                   autocomplete="new-password" />

            <span asp-validation-for="Input.Password"
                  class="auth-validation"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword"
                   class="auth-label"></label>

            <input asp-for="Input.ConfirmPassword"
                   class="form-control auth-input"
                   placeholder="Digite a senha novamente"
                   autocomplete="new-password" />

            <span asp-validation-for="Input.ConfirmPassword"
                  class="auth-validation"></span>
        </div>

        <button type="submit"
                class="btn auth-button w-100">
            Criar minha conta
        </button>
    </form>

    <div class="auth-footer">
        Já tem uma conta?
        <a asp-page="/Account/Login" class="auth-link">
            Entrar
        </a>
    </div>
</section>
