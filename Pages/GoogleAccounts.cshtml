@page
@model SinkDrive.Pages.GoogleAccounts
@{
    ViewData["Title"] = "Contas Google";
}

<h1>Contas Google</h1>

<a class="btn btn-primary mb-3" href="/auth/google/connect">Conectar conta</a>

@if (Model.Accounts.Count == 0)
{
    <p>Nenhuma conta conectada.</p>
}
else
{
    <ul class="list-group">
        @foreach (var account in Model.Accounts)
        {
            <li class="list-group-item list-group-item-secondary m-1">@account.Email</li>
        }
    </ul>
}